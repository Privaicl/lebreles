{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lebreles",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  // El Worker atiende la portada (para la cookie de sesión) y la API; el resto son archivos estáticos.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lebreles",
      "database_id": "fb3466fe-0532-4d19-9182-5e0b21b4e80a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://lebreles.cl,https://www.lebreles.cl,https://lebreles.kelly-f7c.workers.dev,https://lebreles.privai-demo.workers.dev,http://localhost:8787",
    "BREVO_LIST_ID": "3"
  },
  "triggers": {
    // 03:40 en Chile (UTC-3): purga de datos vencidos, ver src/retention.ts
    "crons": ["40 6 * * *"]
  },
  "observability": { "enabled": true }
}
